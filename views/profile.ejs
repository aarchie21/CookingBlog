<div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <h2 class="mb-4 text-center">Profile</h2>
    <div class="card p-4 mb-4">
      <h4>Username: <%= user.username %></h4>
      <h5>Email: <%= user.email %></h5>
      <a href="/logout" class="btn btn-danger mt-4 w-100">Logout</a>
    </div>

    <h3 class="mb-3">Your Uploaded Recipes</h3>
    <% if (recipes && recipes.length > 0) { %>
      <div class="row row-cols-2 row-cols-lg-5 g-2 g-lg-3">
        <% recipes.forEach(function(recipe) { %>
          <a href="/recipe/<%= recipe._id %>" class="col text-center category__link">
            <div class="category__img category__img--large shadow">
              <img src="/upload/<%= recipe.image %>" alt="<%= recipe.name %>" loading="lazy">
            </div>
            <div class="pt-1">
              <%= recipe.name %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p>You have not uploaded any recipes yet.</p>
    <% } %>
  </div>
</div> 